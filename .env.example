# Copy to .env (or export in your shell). All fields are optional.

# Leave LLM_PROVIDER unset to run the offline deterministic baseline.
LLM_PROVIDER=mock

# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, Qwen, Moonshot, vLLM, Ollama.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Retrieval / escalation tuning
TOP_K=4
ESCALATION_CONFIDENCE=0.55
